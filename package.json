{
  "name": "@exorgroup/apex-ui",
  "version": "0.1.0",
  "description": "APEX Pando UI — Vue 3 form controls for Laravel applications.",
  "license": "proprietary",
  "type": "module",
  "files": ["dist", "src"],
  "main": "./dist/apex-ui.umd.cjs",
  "module": "./dist/apex-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/apex-ui.js",
      "require": "./dist/apex-ui.umd.cjs"
    },
    "./style.css": "./dist/apex-ui.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./adapters/zod": "./dist/adapters/zod.js",
    "./adapters/precognition": "./dist/adapters/precognition.js"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue-i18n": { "optional": true },
    "zod": { "optional": true },
    "laravel-precognition-vue": { "optional": true }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
