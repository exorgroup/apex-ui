{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "dist",
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"],

  /* The page-render spec mounts the docs app, and importing its .vue files
     would drag them into this program — where they report the docs repo's own
     errors, chiefly that @exorgroup/apex-ui ships no declarations yet. That is
     the distribution work, deliberately left until last. The spec still runs
     under vitest, which does not typecheck; excluding it keeps this typecheck
     about the library. Revisit once dist/index.d.ts exists. */
  /* zz-hidden-reset reads the stylesheet with `fs`, because Vite stubs a CSS
     import to an empty string under vitest and the glob version of that guard
     silently compared against nothing. Node types are not installed here, so it
     is excluded for the same reason as the spec above. */
  /* service-stage mounts the docs app for the same reason, and drags in the
     same undeclared imports, so it is excluded on the same grounds. */
  "exclude": [
    "tests/zz-docs-pages.spec.ts",
    "tests/zz-hidden-reset.spec.ts",
    "tests/service-stage.spec.ts"
  ]
}
